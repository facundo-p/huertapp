{
  "name": "huerta-gba",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "node scripts/build-enriched.mjs --check && vitest run",
    "test:watch": "vitest",
    "data:build": "node scripts/build-enriched.mjs",
    "data:tabla": "node scripts/build-tabla-revision.mjs",
    "iconos": "node scripts/build-iconos.mjs",
    "shots": "npm run build && playwright test e2e/screenshots.spec.ts",
    "e2e": "npm run build && playwright test e2e/backup.spec.ts e2e/pwa.spec.ts e2e/accesibilidad.spec.ts"
  },
  "dependencies": {
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource-variable/quicksand": "^5.3.0",
    "idb": "^8.0.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^8.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
