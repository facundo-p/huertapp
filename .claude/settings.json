{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/no-tocar-generados.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/no-matar-ajenos.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/rama-de-trabajo.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(npm test)",
      "Bash(npm run build)",
      "Bash(npm run data:build)",
      "Bash(npm run data:tabla)",
      "Bash(npm run e2e)",
      "Bash(npm run shots)",
      "Bash(npm run iconos)",
      "Bash(npx tsc -b)",
      "Bash(npx vitest run:*)",
      "Bash(npx playwright test:*)",
      "Bash(node scripts/build-enriched.mjs:*)"
    ]
  }
}
